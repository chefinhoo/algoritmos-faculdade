algoritmo "semnome"
// Função :
// Autor(a): Danilo Ramos
// Data : 04/09/2015
// Seção de Declarações 
var
   gol : inteiro
inicio
// Seção de Comandos

para gol de 1 ate 6 faca
     escreval("Gol do Inter", gol)
fimpara

para gol de 1 ate 6 faca
     escreval("Inter", gol," x 0 Vasco")
fimpara

fimalgoritmo
