algoritmo "semnome"
// Função :
// Autor(a): Danilo Ramos
// Data : 04/09/2015
// Seção de Declarações 
var
inter : inteiro
inicio
// Seção de Comandos
inter <-0
enquanto (inter<> 6) faca
         inter <- inter +1
         escreval("Gol do internacional",inter,"! Vasco 0")
fimenquanto
fimalgoritmo
