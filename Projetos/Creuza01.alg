algoritmo "Creuza01"
// Professor(a): Anderson de Jesus
// Autor(a): Danilo Ramos

var
   ano_nasc, ano_atual, idade: inteiro
inicio
      escreva("Em que ano nós estamos? ")
      leia(ano_atual)
      escreva("Em que ano eu nasci? ")
      leia(ano_nasc)
      
      idade <- ano_atual-ano_nasc
      escreva("Você tem ", idade, " anos ")
fimalgoritmo
