algoritmo "semnome"
// Professor(a): Anderson de Jesus
// Autor(a): Danilo Ramos

var
   golb, golm, dif: real
inicio
      escreval(" BANGU X MADUREIRA")
      escreva("Quantos gols o Bangu fez? ")
      leia(golb)
      escreva("Quantos gols o Madureira fez? ")
      leia(golm)
      
      dif <- golb - golm
      
      escreval(dif)
fimalgoritmo
