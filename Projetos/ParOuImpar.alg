algoritmo "ParOuImpar"
// Professor(a): Anderson de Jesus
// Autor(a): Danilo Ramos

var
   n: inteiro
inicio
      escreva("Informe um numero qualquer: ")
      leia(n)
      se(n % 2 = 0) entao
           escreval("Esse numero é par")
      senao
           escreva("Esse numero é impar")
      fimse
fimalgoritmo
