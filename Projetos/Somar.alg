algoritmo "SomarValores"
// Função :
// Autor(a): Danilo Ramos
// Data : 09/09/2015
// Seção de Declarações 
var
   v1, v2, s: inteiro
inicio
// Seção de Comandos 
   escreva("Informe o um valor: ")
   leia(v1)
   escreva("Informe outro valor: ")
   leia(v2)
   escreva("")
   s <- v1+v2
   escreva("O resultado encontrado para soma
   entre", v1, " e ", v2, " foi de: ",s)
   
fimalgoritmo
